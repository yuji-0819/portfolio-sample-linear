# ===== LINE Developers コンソール > Messaging API チャネル で取得 =====
# 「チャネル基本設定」タブ の チャネルシークレット
LINE_CHANNEL_SECRET=
# 「Messaging API設定」タブ の チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# ===== Claude (Anthropic) API キー =====
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=

# ===== 管理画面 =====
# 管理画面（https://あなたのサーバー/admin）に入るためのパスワード。長く推測されにくいものに
# ユーザー名は何でも構いません（例: admin）
ADMIN_PASSWORD=

# ===== 運営者（あなた）への通知 =====
# あなた自身の LINE ユーザーID（U から始まる33文字）
# LINE Developers コンソール「チャネル基本設定」の一番下「あなたのユーザーID」で確認できます
# ※ 事前にあなた自身がこの公式アカウントを友だち追加しておいてください
ADMIN_USER_ID=

# ===== 保存先 =====
# 設定・相談者カルテ・返信予約の保存先フォルダ（サーバーの永続ディスクを指定してください）
DATA_DIR=data

# ===== 任意 =====
# 初回起動時に使うテンプレート（fortune = 占い師 / blank = 白紙）。2回目以降は管理画面の設定が使われます
TEMPLATE=fortune
# 使用モデル
CLAUDE_MODEL=claude-opus-5-5
# 1人あたり覚えておく会話の往復数
HISTORY_TURNS=20
# この時間（分）やり取りがなければ、新しい相談として扱う
HISTORY_TTL_MINUTES=720
# サーバーのポート
PORT=3000
