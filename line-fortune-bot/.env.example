# ===== LINE Developers コンソール > Messaging API チャネル で取得 =====
# 「チャネル基本設定」タブ の チャネルシークレット
LINE_CHANNEL_SECRET=
# 「Messaging API設定」タブ の チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# ===== Claude (Anthropic) API キー =====
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=

# ===== 任意設定（未設定なら既定値） =====
# 使用モデル
CLAUDE_MODEL=claude-opus-5-5
# 考える深さ: low / medium / high（高いほど丁寧だが返信が遅く高コスト）
CLAUDE_EFFORT=medium
# 1ユーザーあたり覚えておく会話の往復数
HISTORY_TURNS=20
# 会話の記憶を保持する時間（分）。これを過ぎると新しい相談として扱う
HISTORY_TTL_MINUTES=720
# サーバーのポート
PORT=3000

# ===== 個別チャット鑑定（有料）の案内と有人対応 =====
# あなた（占い師本人）の LINE ユーザーID（U から始まる33文字）
# LINE Developers コンソール「チャネル基本設定」の一番下「あなたのユーザーID」で確認できます
# ※ 事前にあなた自身がこの公式アカウントを友だち追加しておいてください
ADMIN_USER_ID=
# 何回相談を受けてから案内してよいか（相談者から希望された場合は除く）
OFFER_MIN_TURNS=3
# 一度案内したら、次に案内できるまでの日数
OFFER_COOLDOWN_DAYS=7
# 命に関わる言葉が出たら、案内を止める日数
OFFER_CRISIS_BLOCK_DAYS=14
# 相談者カルテの保存先フォルダ（サーバーの永続ディスクを指定してください）
DATA_DIR=data

# ===== 人間らしい返信タイミング =====
# 返信までの時間（分）。この範囲でランダムに決まり、短めが多くときどき長めになる
REPLY_DELAY_MIN_MINUTES=5
REPLY_DELAY_MAX_MINUTES=40
# 返信待ちの相談が1件増えるごとに足す分数（混んでいるほど返信が遅くなる）
REPLY_DELAY_PER_PENDING_MINUTES=2
# この時間帯（日本時間）は返信せず、明けてから返す。空にすると深夜も返信する
QUIET_HOURS=1-8
# 購入スクショへのお礼を送るまでの時間（分）
PURCHASE_REPLY_MIN_MINUTES=1
PURCHASE_REPLY_MAX_MINUTES=4
