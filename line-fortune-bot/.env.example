# ===== LINE Developers コンソール > Messaging API チャネル で取得 =====
# 「チャネル基本設定」タブ の チャネルシークレット
LINE_CHANNEL_SECRET=
# 「Messaging API設定」タブ の チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# ===== Claude (Anthropic) API キー =====
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=

# ===== 任意設定（未設定なら既定値） =====
# 使用モデル
CLAUDE_MODEL=claude-opus-5-5
# 考える深さ: low / medium / high（高いほど丁寧だが返信が遅く高コスト）
CLAUDE_EFFORT=medium
# 1ユーザーあたり覚えておく会話の往復数
HISTORY_TURNS=20
# 会話の記憶を保持する時間（分）。これを過ぎると新しい相談として扱う
HISTORY_TTL_MINUTES=720
# サーバーのポート
PORT=3000
